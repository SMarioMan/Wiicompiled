# syntax=docker/dockerfile:1
ARG LINUX_BUILDER=wiicompiled-linux-toolchain
FROM ${LINUX_BUILDER} AS builder
COPY . .
RUN --mount=type=tmpfs,target=/tmp \
    --mount=type=cache,target=/opt/cross-downloads \
    --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
      export CURL_CA_BUNDLE=/run/secrets/proxy_ca SSL_CERT_FILE=/run/secrets/proxy_ca \
        CMAKE_TLS_CAINFO=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends python3-pil && \
    rm -rf /var/lib/apt/lists/* && \
    bash docker/prepare-windows-cross.sh && \
    chmod -R a+rX /opt/wiicompiled /opt/windows-cross
# Product selection does not change the compiler/toolchain image layers.
ARG PRODUCT=base
ARG LAYOUT_PLAYERS=12
ARG EXPERIMENTAL_LAYOUTS=0
ENV WIICOMPILED_PRODUCT=$PRODUCT \
    WIICOMPILED_LAYOUT_PLAYERS=$LAYOUT_PLAYERS \
    WIICOMPILED_EXPERIMENTAL_LAYOUTS=$EXPERIMENTAL_LAYOUTS
ENTRYPOINT ["bash", "/opt/wiicompiled/docker/build-windows-cross.sh"]
